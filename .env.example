BOT_TOKEN=your_telegram_bot_token
ADMIN_ID=your_telegram_user_id
MONGODB_URI=your_mongodb_connection_uri
STORAGE_CHANNEL_ID=-1001234567890
PORT=3000
DB_NAME=telegram_file_store

# Optional: comma-separated Telegram channel IDs for personal user storage.
# The bot must be an administrator in every channel listed here.
# If left empty, personal files fall back to STORAGE_CHANNEL_ID.
PERSONAL_STORAGE_CHANNEL_IDS=-1001111111111,-1002222222222
